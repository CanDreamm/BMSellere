[Unit]
Description=BMSeller Python web application
After=network.target

[Service]
User=bmseller
Group=bmseller
WorkingDirectory=/opt/BMSeller
EnvironmentFile=/etc/bmseller.env
ExecStart=/opt/BMSeller/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/BMSeller/data

[Install]
WantedBy=multi-user.target
