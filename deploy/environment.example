# systemd EnvironmentFile format; not loaded automatically by Python.
# Replace this value before starting the web service.
APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_PATH=/opt/BMSeller/data/app.db
# Optional HTTPS XLSX source:
# COMPANY_FEED_URL=https://data.example.ru/companies.xlsx
FEED_INTERVAL_SECONDS=86400
JOB_DELAY_SECONDS=2
# Mail.ru: create a separate password for an external mail application.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
# Fill these on the server; sending remains disabled until all are present.
# SMTP_USER=your-address@mail.ru
# SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
# SMTP_FROM=your-address@mail.ru
# Registry-first research (paid/search-provider quota). Not auto-enabled on import.
# BRAVE_SEARCH_API_KEY=REPLACE_SECURELY
